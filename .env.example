# Service user API key (starts with `cog_`), or a Personal Access Token.
# Provision under Settings > Devin API > Service users (https://app.devin.ai/settings/devin-api).
# Without it the dashboard renders demo data.
DEVIN_API_KEY=

# Organization ID (starts with `org-`), shown at the top of Settings > Devin API.
DEVIN_ORG_ID=

# Optional override, defaults to https://api.devin.ai.
# Only needed for dedicated Devin Enterprise deployments (e.g. https://api.your-company.devinenterprise.com).
DEVIN_API_BASE_URL=
